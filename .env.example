# ===== Application =====
APP_NAME=academic-figure-generator
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== Local Storage =====
# Defaults are absolute paths under backend/data/. Override both together.
# DATABASE_PATH=./data/app.db
# DATA_DIR=./data

# ===== OpenAI =====
# Recommended: set this as a Mac/system environment variable instead of writing it here:
# export OPENAI_API_KEY="your-openai-api-key"
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# Quality-first defaults verified against official OpenAI docs on 2026-10-02.
OPENAI_TEXT_MODEL=gpt-6-astra
# Astra: low, medium, high, xhigh, max.
OPENAI_TEXT_REASONING_EFFORT=max
# Shared budget for reasoning and final structured prompts, not a quality setting.
OPENAI_TEXT_MAX_OUTPUT_TOKENS=32768
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Image 2.5: low, medium, high, xhigh, max, auto. Older models support up to high.
OPENAI_IMAGE_QUALITY=max

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# Local single-user app: do not expose it to a public network.

# ===== Durable Jobs =====
# One Uvicorn worker per database. This controls in-process job concurrency.
MAX_CONCURRENT_JOBS=2

# ===== File Upload =====
MAX_UPLOAD_SIZE_MB=50
